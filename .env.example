# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# Google Maps API Key (Optional: defaults to OpenStreetMap if empty)
VITE_GOOGLE_MAPS_API_KEY=""

# Razorpay Test Credentials (Test Mode for EV charging checkout)
# Generate from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys (in Test Mode)
VITE_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret"
